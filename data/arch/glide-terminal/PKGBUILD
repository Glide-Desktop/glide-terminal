pkgname=glide-terminal
pkgver=0.1.r0.g0000000
pkgrel=1
pkgdesc="Terminal of the Glide desktop"
arch=(x86_64)
url="https://github.com/Glide-Desktop/glide-terminal"
license=(GPL-3.0-or-later)
depends=(
    glibc gcc-libs libglvnd vulkan-icd-loader wayland libxkbcommon hicolor-icon-theme
    glide-configd dbus xdg-utils pipewire-audio man-db
)
optdepends=('glide-files: file links open in Glide Files')
makedepends=(git cargo pkgconf)
options=(!lto !debug)
_git="${GLIDE_GIT:-https://github.com/Glide-Desktop}"
_target="${GLIDE_CARGO_TARGET:-target}"
source=("$pkgname::git+$_git/glide-terminal.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf '0.1.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$_target"
    cargo build --frozen --release -p glide-terminal
}

package() {
    cd "$pkgname"
    install -Dm755 $_target/release/glide-terminal "$pkgdir/usr/bin/glide-terminal"
    install -Dm644 data/glide-terminal.desktop "$pkgdir/usr/share/applications/glide-terminal.desktop"
    install -Dm644 data/glide-terminal-search-provider.ini \
        "$pkgdir/usr/share/gnome-shell/search-providers/glide-terminal-search-provider.ini"
    install -d "$pkgdir/usr/share/dbus-1/services"
    sed 's|^Exec=.*/glide-terminal|Exec=/usr/bin/glide-terminal|' data/org.glide.Terminal.service \
        > "$pkgdir/usr/share/dbus-1/services/org.glide.Terminal.service"
    chmod 644 "$pkgdir/usr/share/dbus-1/services/org.glide.Terminal.service"
    install -Dm644 data/defaults/terminal.json "$pkgdir/usr/share/glide/defaults/terminal.json"
    install -Dm644 data/sounds/terminal-bell.mp3 "$pkgdir/usr/share/glide/sounds/terminal-bell.mp3"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
